#!/usr/bin/env python3
"""mdview FILE.md  - open a Markdown file in the Markdown Reader (browser)."""
import sys, os, json, time, html, subprocess, pathlib

HOME = pathlib.Path.home()
BASE = HOME / "mdreader"                 # visible folder: snap Firefox cannot read hidden dirs or /tmp
TEMPLATE = pathlib.Path("/usr/share/mdreader/reader.html")
VIEWS = BASE / "views"

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--default":
        for m in ("text/markdown", "text/x-markdown"):
            subprocess.run(["xdg-mime", "default", "mdreader.desktop", m])
        print("Markdown Reader is now the default app for .md files"); return
    if len(sys.argv) < 2:
        print("usage: mdview FILE.md ...   |   mdview --default  (make it the default .md app)"); sys.exit(1)
    if not TEMPLATE.exists():
        print(f"NOT FOUND: {TEMPLATE}"); sys.exit(1)
    VIEWS.mkdir(parents=True, exist_ok=True)
    now = time.time()
    for old in VIEWS.glob("*.html"):            # keep the folder small: drop views older than 2 days
        if now - old.stat().st_mtime > 2 * 86400:
            old.unlink(missing_ok=True)
    for arg in sys.argv[1:]:
        p = pathlib.Path(arg.replace("file://", "")).expanduser().resolve()
        if not p.is_file():
            print(f"NOT FOUND: {p}"); continue
        text = p.read_text(encoding="utf-8", errors="replace")
        payload = json.dumps({"text": text, "name": p.name}).replace("</", "<\\/")
        base_href = html.escape(p.parent.as_uri() + "/", quote=True)   # relative images resolve next to the .md
        inject = f'<base href="{base_href}">\n<script>window.__MD={payload};</script>\n'
        page = TEMPLATE.read_text(encoding="utf-8").replace("<head>", "<head>\n" + inject, 1)
        out = VIEWS / (p.stem[:60] + f"-{int(now*1000)%100000}.html")
        out.write_text(page, encoding="utf-8")
        subprocess.Popen(["xdg-open", str(out)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

main()

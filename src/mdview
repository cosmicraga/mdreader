#!/usr/bin/env python3
"""mdview FILE.md ...   open Markdown files in the Markdown Reader (browser)
   mdview --default    make Markdown Reader the default app for .md files
   mdview --stop       stop the live-reload watcher
   mdview --clean      stop the watcher and delete all saved pages (keeps recent list and positions)
   mdview              (no file, e.g. from the app grid) choose files in a file picker
   Links in a note to other .md files open them in the reader too."""
import sys, os, json, time, html, re, hashlib, hmac, secrets, base64, signal, threading, subprocess, pathlib, shutil
from http.server import HTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs, unquote, quote

os.umask(0o077)                          # every file mdview writes is private (pages hold the note text)

HOME = pathlib.Path.home()
BASE = HOME / "mdreader"                 # visible folder: snap Firefox cannot read hidden dirs or /tmp
VIEWS = BASE / "views"
RECENT = BASE / "recent.json"
WATCH = BASE / "watch.json"              # files the live-reload watcher follows
PIDFILE = BASE / "watch.pid"
SERVERJ = BASE / "server.json"           # {pid, port} of the save helper (inside the watcher)
SERVERJS = VIEWS / "server.js"           # same port, readable by the pages (script tag)
SECRET = BASE / "secret"                 # key for per-file save tokens
BACKUPS = BASE / "backups"               # copy of a file before each save
LIB = pathlib.Path("/usr/share/mdreader/lib")
if not LIB.is_dir():
    LIB = BASE / "lib"
LIBS = ("marked.min.js", "purify.min.js", "highlight.min.js", "tex-svg-full.min.js", "mermaid.min.js")
TEMPLATE = pathlib.Path("/usr/share/mdreader/reader.html")
if not TEMPLATE.exists():                # fallback for a home-folder install
    TEMPLATE = BASE / "reader.html"

MD_EXT = {".md", ".markdown", ".mdown", ".mkd"}
MAX_FOLDER = 300                         # files prepared per folder
MAX_BYTES = 3 * 1024 * 1024              # skip huge files in the folder list
MAX_RECENT = 15
MAX_DEPTH = 2                            # subfolder levels included in the folder list
SKIP_DIRS = {"node_modules", "build", "dist", "venv", "__pycache__", "_archive"}
KEEP_DAYS = 2                            # views not refreshed for this long are deleted
WATCH_HOURS = 24                         # a file is watched this long after it was last prepared
BACKUP_DAYS = 30
MAX_SAVE = 8 * 1024 * 1024               # largest body the save helper accepts
MAX_LINKED = 100                         # extra pages for files the prepared notes link to


# ---------- helpers ----------
def view_path(p):
    stem = re.sub(r"[^\w.-]+", "_", p.stem)[:50] or "file"
    return VIEWS / f"{stem}-{hashlib.sha1(str(p).encode()).hexdigest()[:8]}.html"


def live_path(p):
    return view_path(p).with_suffix(".live.js")


def natural_part(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def mtime(p):
    return str(os.stat(p).st_mtime_ns)


def write_atomic(path, text):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def js_json(obj):
    """JSON that is safe inside <script>: no <, >, & or line separators left as raw characters."""
    return (json.dumps(obj).replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
            .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029"))


def secret():
    try:
        return bytes.fromhex(SECRET.read_text().strip())
    except Exception:
        k = secrets.token_bytes(32)
        try:
            fd = os.open(SECRET, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.write(fd, k.hex().encode()); os.close(fd)
            return k
        except FileExistsError:
            return bytes.fromhex(SECRET.read_text().strip())


def token(p, key):
    """per-file save token: a page can only save its own file"""
    return hmac.new(key, str(p).encode(), hashlib.sha256).hexdigest()


def collect(root):
    """.md files in root and its subfolders (MAX_DEPTH levels), hidden and junk folders skipped."""
    out = []
    for dirpath, dirs, names in os.walk(root):
        d = pathlib.Path(dirpath)
        depth = len(d.relative_to(root).parts)
        dirs[:] = [x for x in dirs if not x.startswith(".") and x not in SKIP_DIRS] if depth < MAX_DEPTH else []
        for n in names:
            f = d / n
            try:
                if f.suffix.lower() in MD_EXT and f.stat().st_size <= MAX_BYTES:
                    out.append(f)
            except OSError:
                pass
        if len(out) > MAX_FOLDER * 2:
            break

    def key(f):                                          # files before subfolders at every level
        parts = f.relative_to(root).parts
        return [(1, natural_part(x)) for x in parts[:-1]] + [(0, natural_part(parts[-1]))]
    out.sort(key=key)
    return out[:MAX_FOLDER]


def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


# ---------- links between notes ----------
_CODE = re.compile(r"^ {0,3}(```|~~~)[^\n]*\n.*?^ {0,3}\1[^\n]*$|`[^`\n]+`", re.S | re.M)
_LINK_RES = (
    re.compile(r"\]\(\s*(<[^>\n]*>|[^\s)]+)"),                       # [text](target)
    re.compile(r"^ {0,3}\[[^\]\n]+\]:\s*(<[^>\n]*>|\S+)", re.M),     # [id]: target
    re.compile(r"<a\s[^>]*?href\s*=\s*[\"']([^\"']+)[\"']", re.I),  # <a href="target">
)


def link_target(raw, base_dir):
    """a link as written in a note -> (key, real path) if it points to a local Markdown file, else None.
    key = the path the browser computes from the page's <base> (no symlinks resolved): the page looks links up by it."""
    raw = html.unescape(raw.strip())
    if raw.startswith("<") and raw.endswith(">"):
        raw = raw[1:-1]
    raw = raw.split("#", 1)[0].split("?", 1)[0]
    if not raw:
        return None
    if re.match(r"[a-zA-Z][\w+.-]*:", raw):                           # a scheme: only file:// counts
        u = urlparse(raw)
        if u.scheme.lower() != "file" or u.netloc not in ("", "localhost"):
            return None
        path = unquote(u.path)
    else:
        path = unquote(raw)
        if not path.startswith("/"):
            path = str(base_dir / path)
    key = os.path.normpath(path)
    if pathlib.PurePath(key).suffix.lower() not in MD_EXT:
        return None
    try:
        real = pathlib.Path(key).resolve()
        if real.is_file() and real.suffix.lower() in MD_EXT and real.stat().st_size <= MAX_BYTES:
            return key, real
    except OSError:
        pass
    return None


def note_links(text, base_dir):
    """[(key, real)] for every link in the note to another local Markdown file (code blocks skipped)"""
    text = _CODE.sub("", text)
    out, seen = [], set()
    for rx in _LINK_RES:
        for m in rx.finditer(text):
            t = link_target(m.group(1), base_dir)
            if t and t[0] not in seen:
                seen.add(t[0]); out.append(t)
    return out


def read_text(p):
    try:
        return p.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None


# ---------- page building ----------
def offline_template(t):
    """use the libraries shipped in LIB instead of cdnjs / Google Fonts. Returns (template, offline?)."""
    if not all((LIB / n).is_file() for n in LIBS):
        return t, False

    def lib(m):
        name = m.group(1).rsplit("/", 1)[-1]
        return f'<script src="{(LIB / name).as_uri()}"></script>' if name in LIBS else ""
    t = re.sub(r'<script src="https://cdnjs\.cloudflare\.com/ajax/libs/([^"]+)"[^>]*></script>', lib, t)
    t = re.sub(r'<link rel="preconnect"[^>]*>\n?', "", t)
    fonts = LIB / "fonts.css"
    t = re.sub(r'<link href="https://fonts\.googleapis\.com/[^"]*" rel="stylesheet">',
               f'<link href="{fonts.as_uri()}" rel="stylesheet">' if fonts.is_file() else "", t)
    return t, True


def csp(page):
    """scripts only from file: and the exact inline scripts of this page (hashes): no network, no injected handlers"""
    hs = " ".join("'sha256-%s'" % base64.b64encode(hashlib.sha256(x.encode()).digest()).decode()
                  for x in re.findall(r"<script>(.*?)</script>", page, re.S))
    return ("default-src 'none'; script-src file: " + hs + "; style-src file: 'unsafe-inline'; font-src file: data:; "
            "img-src file: data: blob: https:; connect-src http://127.0.0.1:*; base-uri file:; "
            "form-action 'none'; frame-src 'none'; object-src 'none'")


def head_insert(page, text):
    m = '<meta charset="utf-8">'
    return page.replace(m, m + "\n" + text, 1) if m in page else page.replace("<head>", "<head>\n" + text, 1)


def write_view(p, folder, root, recent, template, offline=False, key=b"", pages=None):
    try:
        text = p.read_text(encoding="utf-8", errors="replace")
        mt = mtime(p)
    except Exception:
        return None
    links = {}                                           # link path (as the browser resolves it) -> page
    for k, real in note_links(text, p.parent):
        v = (pages or {}).get(str(real))
        if v:
            links[k] = v
    data = {
        "text": text, "name": p.name, "path": str(p), "dir": str(p.parent), "root": str(root),
        "view": view_path(p).as_uri(), "links": links,
        "mtime": mt, "live": live_path(p).as_uri(), "srv": SERVERJS.as_uri(), "tok": token(p, key) if key else "",
        "folder": [{"name": str(f.relative_to(root)), "path": str(f), "view": view_path(f).as_uri()} for f in folder],
        "recent": [{"name": r.name, "path": str(r), "dir": str(r.parent), "view": view_path(r).as_uri()} for r in recent],
    }
    base_href = html.escape(p.parent.as_uri() + "/", quote=True)   # relative images resolve next to the .md
    inject = f'<base href="{base_href}">\n<script>window.__MD={js_json(data)};</script>\n'
    page = head_insert(template, inject)
    if offline:
        page = head_insert(page, f'<meta http-equiv="Content-Security-Policy" content="{csp(page)}">\n')
    write_atomic(view_path(p), page)
    write_atomic(live_path(p), f"window.__mdLive&&__mdLive({js_json(mt)},null);")
    return mt


# ---------- save helper (runs inside the watcher, 127.0.0.1 only) ----------
def active_watch():
    now = time.time()
    return {p: v for p, v in load_json(WATCH, {}).items() if now - v.get("t", 0) < WATCH_HOURS * 3600}


def save_file(req, key):
    """write the edited text back. Returns (http status, reply)."""
    path, tok, text = req.get("path"), req.get("tok"), req.get("text")
    if not isinstance(path, str) or not isinstance(tok, str) or not isinstance(text, str):
        return 400, {"error": "bad request"}
    if not hmac.compare_digest(tok, token(path, key)):
        return 403, {"error": "wrong token"}
    if path not in active_watch():
        return 403, {"error": "file not open in the reader any more: run mdview on it again"}
    p = pathlib.Path(path)
    if not p.is_absolute() or p.suffix.lower() not in MD_EXT:
        return 403, {"error": "not a Markdown file"}
    real = p.resolve()
    if not real.is_file() or real.suffix.lower() not in MD_EXT:
        return 404, {"error": "file not found"}
    cur = mtime(real)
    if req.get("base") is not None and req.get("base") != cur:
        return 409, {"error": "changed on disk", "mtime": cur}
    old = real.read_bytes()
    if b"\r\n" in old:                                   # keep Windows line endings
        text = text.replace("\r\n", "\n").replace("\n", "\r\n")
    data = text.encode("utf-8")
    if data == old:
        return 200, {"ok": True, "mtime": cur}
    BACKUPS.mkdir(parents=True, exist_ok=True)
    bak = BACKUPS / f"{view_path(real).stem}-{time.strftime('%Y%m%d-%H%M%S')}{real.suffix}"
    bak.write_bytes(old)
    tmp = real.with_name(f".{real.name}.mdreader-tmp")
    try:                                                 # atomic replace, same permissions
        with open(tmp, "wb") as f:
            f.write(data); f.flush(); os.fsync(f.fileno())
        shutil.copymode(real, tmp)
        os.replace(tmp, real)
    except OSError:
        tmp.unlink(missing_ok=True)
        with open(real, "wb") as f:                      # folder not writable: write in place
            f.write(data)
    return 200, {"ok": True, "mtime": mtime(real)}


class SaveHandler(BaseHTTPRequestHandler):
    server_version = "mdreader"
    sys_version = ""

    def log_message(self, *a):
        pass

    def allowed(self):
        # pages are file:// (Origin "null") and must name this exact host; anything else is refused
        return (self.path == "/save" and self.headers.get("Origin") == "null"
                and self.headers.get("Host") == f"127.0.0.1:{self.server.server_port}")

    def reply(self, code, obj, cors=True):
        body = json.dumps(obj).encode()
        self.send_response(code)
        if cors:
            self.send_header("Access-Control-Allow-Origin", "null")
            self.send_header("Vary", "Origin")
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        if not self.allowed():
            return self.reply(403, {"error": "forbidden"}, cors=False)
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "null")
        self.send_header("Access-Control-Allow-Methods", "POST")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Vary", "Origin")
        self.end_headers()

    def do_GET(self):
        self.reply(403, {"error": "forbidden"}, cors=False)

    def do_POST(self):
        if not self.allowed() or not self.headers.get("Content-Type", "").startswith("application/json"):
            return self.reply(403, {"error": "forbidden"}, cors=False)
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            n = -1
        if n <= 0 or n > MAX_SAVE:
            return self.reply(413, {"error": "too large"})
        try:
            req = json.loads(self.rfile.read(n))
            code, out = save_file(req if isinstance(req, dict) else {}, self.server.key)
        except Exception as e:
            code, out = 500, {"error": type(e).__name__}
        self.reply(code, out)


def start_server():
    srv = HTTPServer(("127.0.0.1", 0), SaveHandler)
    srv.key = secret()
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    port = srv.server_address[1]
    write_atomic(SERVERJ, json.dumps({"pid": os.getpid(), "port": port}))
    write_atomic(SERVERJS, f"window.__mdSrv&&__mdSrv({port});")
    return srv


# ---------- live-reload watcher ----------
def watcher_running():
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return "mdview" in pathlib.Path(f"/proc/{pid}/cmdline").read_text(errors="ignore")
    except Exception:
        return False


def start_watcher():
    if watcher_running():
        try:                                             # a watcher from an older version has no save helper
            if load_json(SERVERJ, {}).get("pid") == int(PIDFILE.read_text()):
                return
        except Exception:
            pass
        stop_watcher(quiet=True)
        time.sleep(0.5)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--watch"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def watch_loop():
    if watcher_running():
        return
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))   # so the finally block runs on --stop
    PIDFILE.write_text(str(os.getpid()))
    last, data, wmt = {}, {}, None
    try:
        start_server()
        while True:
            try:
                m = WATCH.stat().st_mtime_ns
                if m != wmt:
                    wmt, data = m, load_json(WATCH, {})
            except OSError:
                data = {}
            now = time.time()
            active = {p: v for p, v in data.items() if now - v.get("t", 0) < WATCH_HOURS * 3600}
            if not active:
                break
            for p, v in active.items():
                try:
                    mt = mtime(p)
                except OSError:
                    continue
                if p not in last:
                    last[p] = v.get("mtime", mt)          # the version the page was built with
                if mt != last[p]:
                    last[p] = mt
                    try:
                        text = pathlib.Path(p).read_text(encoding="utf-8", errors="replace")
                        write_atomic(pathlib.Path(v["live"]), f"window.__mdLive&&__mdLive({js_json(mt)},{js_json(text)});")
                    except Exception:
                        pass
            time.sleep(1)
    finally:
        try:
            if PIDFILE.read_text() == str(os.getpid()):
                PIDFILE.unlink()
                SERVERJ.unlink(missing_ok=True)
                SERVERJS.unlink(missing_ok=True)
        except Exception:
            pass


def stop_watcher(quiet=False):
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 15)
        quiet or print("watcher stopped")
    except Exception:
        quiet or print("watcher was not running")


def clean():
    stop_watcher()
    n, size = 0, 0
    if VIEWS.exists():
        for f in VIEWS.iterdir():
            if f.is_file():
                size += f.stat().st_size
                f.unlink(missing_ok=True)
                n += 1
    WATCH.unlink(missing_ok=True)
    PIDFILE.unlink(missing_ok=True)
    SERVERJ.unlink(missing_ok=True)
    print(f"deleted {n} saved pages ({size / 1024 / 1024:.1f} MB) from {VIEWS} (backups in {BACKUPS} kept)")


def known_files():
    """files the reader opened recently (recent list + files the watcher follows)"""
    return set(load_json(RECENT, [])) | set(active_watch())


def reveal(url):
    """mdreader://reveal?path=/abs/file.md -> show the file in the file manager.
    Any web page can call this link, so: only files the reader opened, folders only, never runs anything."""
    q = parse_qs(urlparse(url).query)
    raw = q.get("path", [""])[0]
    known = set(load_json(RECENT, [])) | set(load_json(WATCH, {}))
    if raw not in known:
        return
    p = pathlib.Path(raw)
    if not p.is_absolute() or not p.is_file():
        return
    p = p.resolve()
    if shutil.which("nautilus"):
        subprocess.Popen(["nautilus", "--select", str(p)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        subprocess.Popen(["xdg-open", str(p.parent)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def link_allowed(target, src, known):
    """may mdreader://open show this file? Any web page can call the link, so only Markdown files that
    (a) a note the reader opened links to, or (b) lie in the folder of an opened file (2 subfolder levels, no hidden parts)."""
    if src and src in known:
        sp = pathlib.Path(src)
        txt = read_text(sp)
        if txt is not None and any(real == target for _, real in note_links(txt, sp.parent)):
            return True
    for k in known:
        root = pathlib.Path(k).resolve().parent
        try:
            rel = target.relative_to(root).parts
        except ValueError:
            continue
        if len(rel) - 1 <= MAX_DEPTH and not any(x.startswith(".") for x in rel):
            return True
    return False


def notify(msg):
    """a link click has no terminal: say it on the desktop"""
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Markdown Reader", "-i", "mdreader", "Markdown Reader", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def open_link(url):
    """mdreader://open?path=/abs/note.md&h=heading&from=/abs/source.md : a link in a note whose page was not
    prepared (link added after mdview ran). Opens it like `mdview note.md`. Never runs anything."""
    q = parse_qs(urlparse(url).query)
    raw, src, h = q.get("path", [""])[0], q.get("from", [""])[0], q.get("h", [""])[0][:200]
    if not raw.startswith("/"):
        return
    p = pathlib.Path(os.path.normpath(raw))
    if p.suffix.lower() not in MD_EXT:
        return
    try:
        real = p.resolve()
        ok = real.is_file() and real.suffix.lower() in MD_EXT and real.stat().st_size <= MAX_BYTES
    except OSError:
        ok = False
    if not ok:
        return notify(f"Linked note not found:\n{p}")
    if not link_allowed(real, src, known_files()):
        return notify(f"Not opened (not linked from an open note, and not in an opened folder):\n{real}")
    open_files([real], jump=h)


def ensure_scheme():
    """register mdreader:// (used by the 'Show in folder' button) for this user, once."""
    try:
        cur = subprocess.run(["xdg-mime", "query", "default", "x-scheme-handler/mdreader"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if cur != "mdreader.desktop":
            subprocess.run(["xdg-mime", "default", "mdreader.desktop", "x-scheme-handler/mdreader"], timeout=5)
    except Exception:
        pass


def pick_files():
    """started without a file (app grid / dash): ask with a file picker, starting in the last folder used"""
    if not shutil.which("zenity"):
        return []
    cmd = ["zenity", "--file-selection", "--multiple", "--separator=\n", "--title=Open Markdown file",
           "--file-filter=Markdown | *.md *.markdown *.mdown *.mkd", "--file-filter=All files | *"]
    recent = [r for r in load_json(RECENT, []) if pathlib.Path(r).is_file()]
    if recent:
        cmd.append(f"--filename={pathlib.Path(recent[0]).parent}/")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except Exception:
        return []
    return [x for x in r.stdout.splitlines() if x] if r.returncode == 0 else []


def to_path(a):
    if a.startswith("file://"):
        a = unquote(urlparse(a).path)
    return pathlib.Path(a).expanduser().resolve()


# ---------- main ----------
def main():
    args = sys.argv[1:]
    if args and args[0] == "--default":
        for m in ("text/markdown", "text/x-markdown", "x-scheme-handler/mdreader"):
            subprocess.run(["xdg-mime", "default", "mdreader.desktop", m])
        print("Markdown Reader is now the default app for .md files")
        return
    if args and args[0] == "--watch":
        watch_loop(); return
    if args and args[0] == "--stop":
        stop_watcher(); return
    if args and args[0] == "--clean":
        clean(); return
    if args and args[0].startswith("mdreader:"):
        (open_link if urlparse(args[0]).netloc == "open" else reveal)(args[0]); return
    if args and args[0] in ("-h", "--help"):
        print(__doc__); return
    if not args:
        args = pick_files()
        if not args:
            if sys.stdin.isatty():
                print(__doc__)
            return
    files = []
    for a in args:
        p = to_path(a)
        if p.is_file():
            files.append(p)
        else:
            print(f"NOT FOUND: {p}")
    if not files:
        sys.exit(1)
    open_files(files)


def open_files(files, jump=""):
    """prepare pages (the files, their folders, recent files, files they link to) and open the files"""
    if not TEMPLATE.exists():
        print(f"NOT FOUND: {TEMPLATE}"); sys.exit(1)
    VIEWS.mkdir(parents=True, exist_ok=True)
    for d in (BASE, VIEWS):                              # older versions made these readable by others
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass
    template, offline = offline_template(TEMPLATE.read_text(encoding="utf-8"))
    key = secret()

    now = time.time()
    for pat in ("*.html", "*.live.js", "*.tmp"):        # old views are removed
        for old in VIEWS.glob(pat):
            if now - old.stat().st_mtime > KEEP_DAYS * 86400:
                old.unlink(missing_ok=True)
    if BACKUPS.exists():
        for old in BACKUPS.iterdir():
            if now - old.stat().st_mtime > BACKUP_DAYS * 86400:
                old.unlink(missing_ok=True)

    recent = [r for r in load_json(RECENT, []) if pathlib.Path(r).is_file()]
    for p in files:                                      # newest first, no duplicates
        recent = [str(p)] + [r for r in recent if r != str(p)]
    recent = recent[:MAX_RECENT]
    try:
        write_atomic(RECENT, json.dumps(recent, indent=0))
    except Exception:
        pass
    recent_p = [pathlib.Path(r) for r in recent]

    # which pages to build: file -> (its folder list, folder root)
    plan = {}
    for p in files:
        root = p.parent
        folder = collect(root)
        if p not in folder:
            folder.insert(0, p)
        for t in folder:
            plan.setdefault(t, (folder, root))
    for r in recent_p:                                   # a recent file outside these folders lists only itself
        plan.setdefault(r, ([r], r.parent))
    # files the opened notes, their folder and the recent files link to (one step) get a page too
    have = {str(t.resolve()) for t in plan}
    extra = []
    for t in list(plan):
        if len(extra) >= MAX_LINKED:
            break
        txt = read_text(t)
        for _, real in (note_links(txt, t.parent) if txt is not None else []):
            if str(real) not in have and len(extra) < MAX_LINKED:
                have.add(str(real)); extra.append(real)
    for real in extra:
        plan.setdefault(real, ([real], real.parent))

    watch = {p: v for p, v in load_json(WATCH, {}).items() if now - v.get("t", 0) < WATCH_HOURS * 3600}
    pages = {}                                           # resolved path -> page URI, for the links maps
    for p in watch:                                      # pages from earlier runs that live reload still follows
        if view_path(pathlib.Path(p)).exists():
            try:
                pages[str(pathlib.Path(p).resolve())] = view_path(pathlib.Path(p)).as_uri()
            except OSError:
                pass
    for t in plan:
        pages[str(t)] = view_path(t).as_uri()
        try:
            pages.setdefault(str(t.resolve()), view_path(t).as_uri())
        except OSError:
            pass
    for t, (folder, root) in plan.items():
        mt = write_view(t, folder, root, recent_p, template, offline, key, pages)
        if mt:
            watch[str(t)] = {"live": str(live_path(t)), "mtime": mt, "t": now}
    try:
        write_atomic(WATCH, json.dumps(watch))
    except Exception:
        pass
    start_watcher()
    ensure_scheme()
    for p in files:
        target = view_path(p)
        if jump:                                         # xdg-open drops #fragments: a tiny redirect page keeps it
            target = VIEWS / f"jump-{secrets.token_hex(6)}.html"
            url = html.escape(view_path(p).as_uri() + "#" + quote(jump, safe=""), quote=True)
            write_atomic(target, f'<!DOCTYPE html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url={url}">\n')
        subprocess.Popen(["xdg-open", str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


main()
